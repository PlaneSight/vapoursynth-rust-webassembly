{
  "name": "vapoursynth-rust-webassembly",
  "private": true,
  "type": "module",
  "scripts": {
    "build:browser": "uv run --locked bash tools/build-browser.sh",
    "serve:web": "uv run --locked python -m http.server 4173",
    "test:python": "uv run --locked python -m unittest discover -s web/python -p test_*.py",
    "test:rust": "uv run --locked cargo test --locked --workspace",
    "test:web": "uv run --locked node --test web/*.test.mjs"
  },
  "devDependencies": {
    "pyodide": "0.29.4"
  }
}
